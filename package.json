{
  "name": "internship-board-api",
  "version": "1.0.0",
  "description": "REST API for a fictional student internship board (Node.js, Express, SQLite).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "db:init": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/init-db.js",
    "db:seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.js",
    "db:reset": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/seed.js --reset",
    "test": "NODE_ENV=test node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "license": "MIT"
}
